{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "packages": {
        ".": {
            "component": "cuicuit-web",
            "release-type": "node",
            "changelog": "CHANGELOG.md",
            "plugins": [
                "sentence-case"
            ],
            "exclude-paths": [
                "scraper"
            ],
            "draft": true,
            "include-commit-authors": true,
            "pull-request-header": "🐥 New version of Cuicuit released!",
            "pull-request-footer": "If you enjoy using Cuicuit, [your support](https://github.com/sponsors/MadeInPierre) means a lot to continue improving the app! Thank you!",
            "prerelease-type": "alpha",
            "prerelease": true,
            "bump-minor-pre-major": true,
            "bump-patch-for-minor-pre-major": true
        }
    }
}