# Copy this file to `.env` and fill in your values.

# --- Supabase (public) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (private) ---
# Service-role key for the server-side supabaseAdmin client (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=...
# Google OAuth login
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# --- LLM (all optional) ---
# LLM features enrich recipes with AI. If you leave this section empty, those
# features fail gracefully and the rest of the app keeps working.

# Comma-separated entries in priority order (first = tried first) of LLM providers:
# LLM_PRIORITY=mistral,mistral2,groq,openai-compatible

# A suffixed entry (e.g. "mistral2") reads its own suffixed env vars:
#   mistral            -> MISTRAL_API_KEY, MISTRAL_MODEL
#   mistral2           -> MISTRAL_API_KEY2, MISTRAL_MODEL2
#   groq2              -> GROQ_API_KEY2, GROQ_MODEL2

# Mistral
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-medium-latest

# Second Mistral source
# MISTRAL_API_KEY2=...
# MISTRAL_MODEL=mistral-small-latest

# Groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible endpoint, e.g. a self-hosted Ollama server
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=

# --- Recipe scraping sources (all optional) ---
# Python recipe-scrapers container (skipped if unset)
PYTHON_SCRAPER_URL=
PYTHON_SCRAPER_KEY=
# SaaS providers — Geonode is tried before Firecrawl
GEONODE_API_KEY=
FIRECRAWL_API_KEY=

# ======================
# === Hosted version ===
# ======================

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- PostHog (public) ---
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
