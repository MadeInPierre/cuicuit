# Copy to `.env` and fill in your values. Never commit real secrets.

# --- Supabase (public) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_URL_CLOUD=

# --- Supabase (private) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# --- LLM ---
MISTRAL_API_KEY=

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Recipe scraping sources (all optional) ---
# Python recipe-scrapers container (skipped if unset)
PYTHON_SCRAPER_URL=
# SaaS providers — Geonode is tried before Firecrawl
GEONODE_API_KEY=
FIRECRAWL_API_KEY=
