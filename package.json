{
	"name": "cuicuit2",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"organize-imports": "npx organize-imports-cli tsconfig[.*].json",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"db:start": "npx --yes supabase start  # Start supabase locally",
		"db:stop": "npx --yes supabase stop  # Stop supabase locally",
		"db:deploy": "npx --yes supabase db push  # Deploy local changes to the database",
		"db:reset": "npx --yes supabase db reset  # Reset the database to the latest migration",
		"db:serve": "npx --yes supabase functions serve  # Serve supabase functions locally",
		"db:types:cloud": "npx --yes supabase gen types typescript --project-id qyeioetcqxvpsqmyqohf > src/lib/shared/db/supabase.types.ts && npm run supazod:update",
		"db:types:local": "npx --yes supabase gen types typescript --local > src/lib/shared/db/supabase.types.ts && npm run supazod:update",
		"supazod:update": "npx supazod -i src/lib/shared/db/supabase.types.ts -o src/lib/shared/db/supazod.schemas.ts --inline-types"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.21.0",
		"@playwright/test": "^1.28.1",
		"@svelte-put/swipeable": "^1.1.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.15.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/vite": "^4.1.12",
		"@types/eslint": "^9.6.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"formsnap": "^2.0.1",
		"globals": "^15.0.0",
		"jsrepo": "^3.0.11",
		"lucide-svelte": "^0.539.0",
		"mode-watcher": "^0.4.1",
		"postcss": "^8.4.47",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"rollup-plugin-visualizer": "^5.12.0",
		"supabase": "^2.84.6",
		"supazod": "^4.5.0",
		"svelte": "^5.38.2",
		"svelte-check": "^4.0.0",
		"svelte-dnd-action": "^0.9.64",
		"svelte-sonner": "^1.0.5",
		"sveltekit-superforms": "^2.20.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.12",
		"tw-animate-css": "^1.3.7",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^5.0.3",
		"vitest": "^2.0.0",
		"zod": "^3.23.8"
	},
	"type": "module",
	"dependencies": {
		"@ai-sdk/mistral": "^3.0.9",
		"@huggingface/inference": "^2.8.1",
		"@number-flow/svelte": "^0.3.9",
		"@supabase/supabase-js": "^2.50.3",
		"ai": "^6.0.38",
		"dotenv": "^16.4.7",
		"fuse.js": "^7.1.0",
		"paneforge": "^1.0.0-next.6",
		"svelte-copy": "^2.0.0"
	}
}
